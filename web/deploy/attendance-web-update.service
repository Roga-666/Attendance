[Unit]
Description=Update Attendance web app from GitHub
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=rolando
Group=rolando
WorkingDirectory=/home/rolando/Portainer/Attendance
ExecStart=/usr/bin/git pull --ff-only origin main
ExecStartPost=/usr/bin/docker compose -f web/compose.yaml up -d --remove-orphans
